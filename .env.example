# Supabase (Project Settings > API). Use a chave publishable, nunca a secret.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Webhook de entrada do n8n (somente no servidor, nunca exposto ao navegador)
N8N_WEBHOOK_URL=https://SEU-N8N/webhook/gohobby-leads
N8N_WEBHOOK_TOKEN=token_de_40_caracteres

# Domínio interno usado para o login (usuário "gohobby" vira gohobby@<dominio>)
LOGIN_EMAIL_DOMAIN=exemplo.com
